# Copy this file to .env.local and fill in real values. Never commit .env.local.
# In production, set the same variables in Vercel → Project → Settings → Environment Variables.

# --- xAI (Grok) ---
# Server-only. Never prefix with NEXT_PUBLIC_ or it will be shipped to the browser.
# From https://console.x.ai → API Keys.
XAI_API_KEY=

# Model ids live in env so they can change without a code change.
# Confirm the current ids on https://docs.x.ai/developers/models before relying on them.
# Realtime voice (listening, transcription, talking back).
XAI_VOICE_MODEL=grok-voice-latest
# Quick calls while you talk: sorting speech into tracks, learning facts.
XAI_FAST_MODEL=grok-4.20-0309-non-reasoning
# Careful work: reading uploaded PDFs and images, summarising who you are.
XAI_TEXT_MODEL=grok-4.7

# --- Auth0 ---
# From the Auth0 dashboard → Applications → your app → Settings.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex string used to encrypt the session cookie: `openssl rand -hex 32`
AUTH0_SECRET=
# http://localhost:3000 locally. On Vercel set it to the one address listed in
# Auth0 (e.g. https://brainstorm-git-main-…vercel.app) so login and logout
# always use it, whichever deploy link someone opened.
APP_BASE_URL=http://localhost:3000

# --- Supabase Postgres (used by Drizzle) ---
# Drizzle has no API key. It connects with a Postgres connection string.
# Supabase dashboard → your project → Connect (top bar) → Connection String.
# Full steps: db/README.md.
# Transaction pooler (port 6543), logged in as brainstorm_app, used by the app (also on Vercel):
# postgresql://brainstorm_app.<project-ref>:<app-password>@<pooler-host>:6543/postgres
DATABASE_URL=
# Session pooler (port 5432) as postgres, with your database password. Only for `npm run db:migrate`.
DIRECT_DATABASE_URL=

# --- Supabase Storage (uploaded files) ---
# Server-only. Never prefix with NEXT_PUBLIC_.
# Project URL: Supabase dashboard → Project Settings → Data API (https://<ref>.supabase.co).
SUPABASE_URL=
# Supabase dashboard → Project Settings → API Keys → Secret keys (starts with sb_secret_).
SUPABASE_SECRET_KEY=
# Private bucket, created by `npm run db:migrate`.
SUPABASE_STORAGE_BUCKET=uploads

# --- Exa (web search, link reader) ---
# Server-only. From https://dashboard.exa.ai → API Keys.
EXA_API_KEY=

# Optional. A GitHub token (no scopes needed) raises the rate limit for reading
# public repos people add to their profile. Without it, GitHub allows 60 reads an hour.
GITHUB_TOKEN=

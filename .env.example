AUTH0_DOMAIN=your-tenant.region.auth0.com
AUTH0_CLIENT_ID=your-auth0-application-client-id
AUTH0_CLIENT_SECRET=your-auth0-application-client-secret
AUTH0_SECRET=generate-a-random-32-byte-hex-secret
APP_BASE_URL=http://localhost:3000

# API Identifier from Auth0 Dashboard > Applications > APIs
AUTH0_AUDIENCE=https://your-api-identifier
# Optional space-separated API scopes granted to this application
AUTH0_API_SCOPE=
# Base URL where your protected API is hosted (not the Auth0 API Identifier)
AUTH0_API_BASE_URL=https://your-api.example.com/

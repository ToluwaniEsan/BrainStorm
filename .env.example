# Copy this file to .env.local and fill in real values. Never commit .env.local.
# In production, set the same variables in Vercel → Project → Settings → Environment Variables.

# --- Gemini (Google AI) ---
# Server-only. Never prefix with NEXT_PUBLIC_ or it will be shipped to the browser.
GEMINI_API_KEY=

# Model ids live in env so they can change without a code change.
# Confirm the current ids on https://ai.google.dev/gemini-api/docs/models before relying on them.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Auth0 ---
# From the Auth0 dashboard → Applications → your app → Settings.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex string used to encrypt the session cookie: `openssl rand -hex 32`
AUTH0_SECRET=
# http://localhost:3000 locally; your production URL on Vercel.
APP_BASE_URL=http://localhost:3000

# --- Auth0 (required) -------------------------------------------------------
# Regular Web Application in your Auth0 tenant.
# Allowed Callback URLs: http://localhost:3000/auth/callback
# Allowed Logout URLs:   http://localhost:3000
# Enable the GitHub social connection under Authentication > Social to allow
# "Sign in with GitHub" (routed through Auth0 via /auth/login?connection=github).
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32+ byte secret used to encrypt the session cookie: `openssl rand -hex 32`
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# --- Postgres + pgvector (required) -----------------------------------------
# Must connect as a NON-superuser role with CREATEROLE that owns the database.
# The pgvector extension must already exist in the database (create it once as a superuser).
DATABASE_URL=postgres://brainstorm:brainstorm@localhost:5432/brainstorm
# Used by `npm test` (isolation + policy suites run against a real Postgres).
TEST_DATABASE_URL=postgres://brainstorm:brainstorm@localhost:5432/brainstorm_test

# --- OpenAI (required for live voice + embeddings) --------------------------
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Grounded assisted search (optional) ------------------------------------
# Only used when the user says they are stuck / explicitly asks for help AND
# relevant memory exists. Leave blank to disable (tool reports "unavailable").
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# --- GitHub ingest (optional) ------------------------------------------------
# Public repos work unauthenticated (60 req/h). A fine-grained token with no
# repo scopes raises the rate limit. Never a user's private-repo token.
GITHUB_TOKEN=
